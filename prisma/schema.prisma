generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  role             String            @default("user")
  banned           Boolean           @default(false)
  banReason        String?
  banExpires       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]      @relation("InvitedBy")
  auditEvents      AuditEvent[]
  contentRevisions ContentRevision[]
  ledProjects      Project[]         @relation("ProjectLead")
  projectMembers   ProjectMember[]
  crewProfile      CrewProfile?
  shareGrants      ShareGrant[]      @relation("ShareGrantCreator")

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  activeTeamId         String?
  impersonatedBy       String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id               String            @id
  name             String
  slug             String            @unique
  logo             String?
  metadata         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  members          Member[]
  invitations      Invitation[]
  auditEvents      AuditEvent[]
  inquiries        Inquiry[]
  portfolioEntries PortfolioEntry[]
  services         Service[]
  servicePackages  ServicePackage[]
  teamMembers      TeamMember[]
  journalPosts     JournalPost[]
  socialLinks      SocialLink[]
  siteSettings     SiteSetting[]
  contentRevisions ContentRevision[]
  clients          Client[]
  projects         Project[]
  projectMilestones ProjectMilestone[]
  crewProfiles     CrewProfile[]
  scheduleItems    ScheduleItem[]
  callSheets       CallSheet[]
  quotes           Quote[]
  deliverables     Deliverable[]
  mediaAssets      MediaAsset[]
  galleries        Gallery[]
  shareGrants      ShareGrant[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  email          String
  inviterId      String
  organizationId String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitedBy", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([email, organizationId])
  @@index([organizationId])
  @@map("invitation")
}

model Inquiry {
  id             String       @id @default(cuid())
  organizationId String
  submissionKey  String       @unique
  name           String
  email          String
  serviceSlug    String
  eventDate      DateTime?
  location       String?
  details        String
  consentedAt    DateTime
  consentVersion String       @default("project-inquiry-v1")
  status         String       @default("new")
  notificationStatus String   @default("pending")
  notificationSentAt DateTime?
  notificationError String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([email, createdAt])
  @@map("inquiry")
}

model PortfolioEntry {
  id             String            @id @default(cuid())
  organizationId String
  slug           String            @unique
  title          String
  summary        String
  categories     String[]
  clientCredit   String?
  productionYear Int?
  brief          String?
  approach       String?
  outcome        String?
  coverImageUrl  String?
  status         String            @default("draft")
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  media          PortfolioMedia[]
  credits        PortfolioCredit[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, publishedAt])
  @@map("portfolio_entry")
}

model RateLimitBucket {
  key             String   @id
  attempts        Int
  windowStartedAt DateTime
  expiresAt       DateTime

  @@index([expiresAt])
  @@map("rate_limit_bucket")
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  resource       String
  resourceId     String?
  requestId      String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_event")
}

model PortfolioMedia {
  id        String         @id @default(cuid())
  entryId   String
  mediaType String         @default("image")
  url       String
  alt       String
  caption   String?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  entry     PortfolioEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, sortOrder])
  @@map("portfolio_media")
}

model PortfolioCredit {
  id        String         @id @default(cuid())
  entryId   String
  role      String
  name      String
  sortOrder Int            @default(0)
  entry     PortfolioEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, sortOrder])
  @@map("portfolio_credit")
}

model Service {
  id             String           @id @default(cuid())
  organizationId String
  slug           String
  name           String
  discipline     String
  summary        String
  description    String?
  status         String           @default("draft")
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packages       ServicePackage[]
  projects       Project[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, sortOrder])
  @@map("service")
}

model ServicePackage {
  id             String       @id @default(cuid())
  organizationId String
  serviceId      String?
  slug           String
  name           String
  summary        String?
  priceLabel     String?
  priceAmount    Int?
  currency       String       @default("NGN")
  features       String[]
  status         String       @default("draft")
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, slug])
  @@index([organizationId, status, sortOrder])
  @@map("service_package")
}

model TeamMember {
  id             String       @id @default(cuid())
  organizationId String
  slug           String
  name           String
  role           String
  department     String?
  bio            String?
  portraitUrl    String?
  status         String       @default("draft")
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId, status, sortOrder])
  @@map("team_member")
}

model JournalPost {
  id             String       @id @default(cuid())
  organizationId String
  slug           String
  title          String
  excerpt        String
  body           String
  coverImageUrl  String?
  authorName     String?
  status         String       @default("draft")
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId, status, publishedAt])
  @@map("journal_post")
}

model SocialLink {
  id             String       @id @default(cuid())
  organizationId String
  platform       String
  label          String?
  url            String
  status         String       @default("draft")
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, sortOrder])
  @@map("social_link")
}

model SiteSetting {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  value          Json
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("site_setting")
}

model ContentRevision {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  resourceType   String
  resourceId     String
  action         String
  snapshot       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, resourceType, resourceId, createdAt])
  @@index([organizationId, createdAt])
  @@map("content_revision")
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  company        String?
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]
  quotes         Quote[]

  @@index([organizationId, name])
  @@index([organizationId, email])
  @@map("client")
}

model Project {
  id             String          @id @default(cuid())
  organizationId String
  clientId       String?
  serviceId      String?
  leadUserId     String?
  slug           String
  name           String
  description    String?
  status         String          @default("planning")
  startDate      DateTime?
  endDate        DateTime?
  budgetAmount   Int?
  currency       String          @default("NGN")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  service        Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  lead           User?           @relation("ProjectLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  milestones     ProjectMilestone[]
  scheduleItems  ScheduleItem[]
  callSheets     CallSheet[]
  quotes         Quote[]
  deliverables   Deliverable[]
  mediaAssets    MediaAsset[]
  galleries      Gallery[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, startDate])
  @@map("project")
}

model ProjectMilestone {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  description    String?
  status         String       @default("planned")
  dueAt          DateTime?
  completedAt    DateTime?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueAt])
  @@index([projectId, sortOrder])
  @@map("project_milestone")
}

model ProjectMember {
  id            String       @id @default(cuid())
  projectId     String
  userId        String?
  crewProfileId String?
  role          String       @default("crew")
  createdAt     DateTime     @default(now())
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  crewProfile   CrewProfile? @relation(fields: [crewProfileId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([crewProfileId])
  @@map("project_member")
}

model CrewProfile {
  id             String             @id @default(cuid())
  organizationId String
  userId         String?            @unique
  name           String
  role           String
  department     String?
  departments    String[]           @default([])
  skills         String[]
  email          String?
  phone          String?
  status         String             @default("active")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  availability   CrewAvailability[]
  projectMembers ProjectMember[]

  @@index([organizationId, department])
  @@index([organizationId, status])
  @@map("crew_profile")
}

model CrewAvailability {
  id            String      @id @default(cuid())
  crewProfileId String
  startsAt      DateTime
  endsAt        DateTime
  status        String      @default("available")
  note          String?
  createdAt     DateTime    @default(now())
  crewProfile   CrewProfile @relation(fields: [crewProfileId], references: [id], onDelete: Cascade)

  @@index([crewProfileId, startsAt])
  @@map("crew_availability")
}

model ScheduleItem {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  startsAt       DateTime
  endsAt         DateTime
  location       String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  callSheets     CallSheet[]

  @@index([organizationId, startsAt])
  @@index([projectId, startsAt])
  @@map("schedule_item")
}

model CallSheet {
  id             String        @id @default(cuid())
  organizationId String
  projectId      String
  scheduleItemId String?
  title          String
  shareToken     String        @unique
  details        Json?
  status         String        @default("draft")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scheduleItem   ScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId])
  @@map("call_sheet")
}

model Quote {
  id               String          @id @default(cuid())
  organizationId   String
  projectId        String?
  clientId         String?
  number           String
  status           String          @default("draft")
  currency         String          @default("NGN")
  subtotal         Int             @default(0)
  discountAmount   Int             @default(0)
  discountLabel    String?
  total            Int             @default(0)
  notes            String?
  acceptedSnapshot Json?
  acceptedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client           Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lineItems        QuoteLineItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@map("quote")
}

model QuoteLineItem {
  id          String @id @default(cuid())
  quoteId     String
  description String
  quantity    Int    @default(1)
  unitAmount  Int    @default(0)
  total       Int    @default(0)
  sortOrder   Int    @default(0)
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
  @@map("quote_line_item")
}

model Deliverable {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  description    String?
  status         String       @default("planned")
  dueAt          DateTime?
  deliveredAt    DateTime?
  reviewUrl      String?
  deliveryToken  String?      @unique
  deliveryExpiresAt DateTime?
  deliveryRevokedAt DateTime?
  deliveryCreatedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueAt])
  @@index([projectId])
  @@map("deliverable")
}

model MediaAsset {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String?
  filename       String
  mimeType       String
  byteSize       Int
  storageKey     String         @unique
  derivativeKey  String?
  thumbnailKey   String?
  width          Int?
  height         Int?
  checksum       String?
  visibility     String         @default("private")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  galleryAssets  GalleryAsset[]
  shareGrants    ShareGrant[]

  @@index([organizationId, visibility])
  @@index([organizationId, createdAt])
  @@map("media_asset")
}

model Gallery {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String?
  slug           String
  title          String
  description    String?
  visibility     String         @default("private")
  status         String         @default("draft")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assets         GalleryAsset[]
  shareGrants    ShareGrant[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("gallery")
}

model GalleryAsset {
  id           String     @id @default(cuid())
  galleryId    String
  mediaAssetId String
  sortOrder    Int        @default(0)
  gallery      Gallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([galleryId, mediaAssetId])
  @@index([galleryId, sortOrder])
  @@map("gallery_asset")
}

model ShareGrant {
  id              String       @id @default(cuid())
  organizationId  String
  galleryId       String?
  mediaAssetId    String?
  createdByUserId String?
  token           String       @unique
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gallery         Gallery?     @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation("ShareGrantCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([token])
  @@map("share_grant")
}
