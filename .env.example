# Required for database-backed Studio authentication, inquiries, and migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dteam?schema=public"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
PUBLIC_INQUIRIES_ENABLED=false

# Connect a private Vercel Blob store to the Vercel project. This variable is created by Vercel.
BLOB_READ_WRITE_TOKEN=

# Gmail SMTP. Use a Google App Password (not your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INQUIRY_NOTIFY_EMAIL=
